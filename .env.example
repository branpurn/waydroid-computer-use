# Copy to .env and fill in. Never commit .env.

# SSH to the Fedora host that runs Waydroid
WAYDROID_SSH_HOST=waydroid.example
WAYDROID_SSH_PORT=22
WAYDROID_SSH_USER=waydroid
# Optional: path to private key (otherwise ssh agent / default keys)
# WAYDROID_SSH_IDENTITY=~/.ssh/id_ed25519

# ADB (on the Fedora host, or forwarded to your workstation)
# ADB=adb
# ADB_SERIAL=emulator-5554

# Control HTTP server (run on a host that can reach ADB)
CONTROL_HOST=0.0.0.0
CONTROL_PORT=8765
# CONTROL_CORS=*
